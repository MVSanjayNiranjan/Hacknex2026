# --- Model files (download from unsloth/Qwen2.5-VL-7B-Instruct-GGUF) ---
MODEL_PATH=Model/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
MMPROJ_PATH=Model/mmproj-F16.gguf

# --- Model runtime (conservative starting point for 8 GB VRAM) ---
# Partial GPU offload. 0 = CPU only. Raise gradually while watching VRAM;
# no value is guaranteed to fit — verify on your machine.
N_GPU_LAYERS=20
N_CTX=8192
N_BATCH=256
MAX_IMAGE_DIM=1024
MAX_TOKENS=1024
# 1 = unload the model after every generation (frees RAM/VRAM between
# questions at the cost of a full reload each time). 0 = keep loaded.
MODEL_IDLE_UNLOAD=0

# --- Retrieval / answering ---
RETRIEVAL_TOP_K=8
MAX_EVIDENCE_PAGES=6
ADJACENT_PAGE_WINDOW=1

# --- Ingestion ---
MAX_FILE_MB=100
MAX_FILES_PER_UPLOAD=10
MAX_PAGES=500
PAGE_RENDER_DPI=150
SCANNED_CHAR_THRESHOLD=30
# 1 = transcribe scanned pages with the vision model during indexing (slow).
VISUAL_TRANSCRIPTION_ENABLED=0

# --- Data locations ---
DATA_DIR=data
# DB_PATH=data/app.db
# UPLOAD_DIR=data/uploads
# PAGE_IMAGE_DIR=data/pages

# --- Server ---
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-me-for-any-shared-use
